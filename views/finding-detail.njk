{% extends "base.njk" %}
{% from "icons.njk" import icon %}
{% from "forms.njk" import feedback, invalid, fieldError %}
{% block title %}{{ finding.title }} · Security Inbox{% endblock %}
{% block content %}
  {% set edit = editForm or finding %}
  {% set statusDraft = statusForm or finding %}
  {% set editErrors = fieldErrors if formSection == 'edit' else {} %}
  {% set statusErrors = fieldErrors if formSection == 'status' else {} %}
  {% set noteErrors = fieldErrors if formSection == 'note' else {} %}
  <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Proyectos</a><span>/</span><a href="/projects/{{ project.id }}/findings">{{ project.name }}</a><span>/</span><span>Detalle</span></nav>
  {{ feedback(formError) }}
  {% if notice %}<div class="notice" role="status">{{ notice }}</div>{% endif %}
  <article class="case-file severity-border--{{ finding.severity }}">
    <header class="case-file__header">
      <div><p class="section-label">Incidencia · {{ finding.id }}</p><h1>{{ finding.title }}</h1></div>
      <div class="finding-row__meta"><span class="severity-tag severity-tag--{{ finding.severity }}">{{ icon(finding.severity) }}{{ severityLabels[finding.severity] }}</span><span class="status-tag status-tag--{{ finding.status }}" data-status="{{ finding.status }}">{{ icon(finding.status) }}{{ statusLabels[finding.status] }}</span></div>
    </header>
    <dl class="case-meta">
      <div><dt>Origen</dt><dd>{{ finding.origin }}</dd></div>
      <div><dt>Ubicación</dt><dd>{% if finding.filePath %}<code>{{ finding.filePath }}{% if finding.lineNumber %}:{{ finding.lineNumber }}{% endif %}</code>{% else %}No indicada{% endif %}</dd></div>
      <div><dt>Commit</dt><dd>{{ finding.commitRef or 'No indicado' }}</dd></div>
      <div><dt>Actualizado</dt><dd><time datetime="{{ finding.updatedAt }}">{{ finding.updatedAt | friendlyDate }}</time></dd></div>
    </dl>
    <section class="case-section"><p class="section-label">Contexto</p><p class="preserve-lines">{{ finding.description }}</p></section>
    <section class="case-section"><p class="section-label">Evidencia</p><p class="preserve-lines">{{ finding.evidence or 'Pendiente de investigar.' }}</p></section>
    <section class="case-section"><p class="section-label">Recomendación</p><p class="preserve-lines">{{ finding.recommendation or 'Sin recomendación registrada.' }}</p></section>
  </article>

  <section class="action-section" aria-labelledby="actions-title">
    <p class="section-label">Gestión</p><h2 id="actions-title">Acciones</h2>
    <div class="action-grid">
      <details class="paper-panel"{% if formSection == 'edit' %} open{% endif %}>
        <summary>Editar incidencia</summary>
        <form method="post" action="/projects/{{ project.id }}/findings/{{ finding.id }}/edit" class="finding-form finding-form--compact">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label class="span-2">Título <input name="title" required maxlength="200" value="{{ edit.title }}" {{ invalid(editErrors, 'title', 'edit-') }}>{{ fieldError(editErrors, 'title', 'edit-') }}</label>
          <label>Gravedad <select name="severity" {{ invalid(editErrors, 'severity', 'edit-') }}>{% for option in severityOptions %}<option value="{{ option.value }}"{% if edit.severity == option.value %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select>{{ fieldError(editErrors, 'severity', 'edit-') }}</label>
          <label>Origen <input name="origin" required maxlength="200" value="{{ edit.origin }}" {{ invalid(editErrors, 'origin', 'edit-') }}>{{ fieldError(editErrors, 'origin', 'edit-') }}</label>
          <label class="span-2">Contexto <textarea name="description" required maxlength="10000" rows="5" {{ invalid(editErrors, 'description', 'edit-') }}>{{ edit.description }}</textarea>{{ fieldError(editErrors, 'description', 'edit-') }}</label>
          <label>Archivo <input name="filePath" maxlength="1000" value="{{ edit.filePath or '' }}" {{ invalid(editErrors, 'filePath', 'edit-') }}>{{ fieldError(editErrors, 'filePath', 'edit-') }}</label>
          <label>Línea <input name="lineNumber" type="number" min="1" max="10000000" value="{{ edit.lineNumber or '' }}" {{ invalid(editErrors, 'lineNumber', 'edit-') }}>{{ fieldError(editErrors, 'lineNumber', 'edit-') }}</label>
          <label class="span-2">Commit <input name="commitRef" maxlength="200" value="{{ edit.commitRef or '' }}" {{ invalid(editErrors, 'commitRef', 'edit-') }}>{{ fieldError(editErrors, 'commitRef', 'edit-') }}</label>
          <label class="span-2">Evidencia <textarea name="evidence" maxlength="10000" rows="5" {{ invalid(editErrors, 'evidence', 'edit-') }}>{{ edit.evidence }}</textarea>{{ fieldError(editErrors, 'evidence', 'edit-') }}</label>
          <label class="span-2">Recomendación <textarea name="recommendation" maxlength="5000" rows="3" {{ invalid(editErrors, 'recommendation', 'edit-') }}>{{ edit.recommendation or '' }}</textarea>{{ fieldError(editErrors, 'recommendation', 'edit-') }}</label>
          <label class="span-2">Nota de edición <span class="optional">opcional</span><textarea name="note" maxlength="5000" rows="2" {{ invalid(editErrors, 'note', 'edit-') }}>{{ edit.note or '' }}</textarea>{{ fieldError(editErrors, 'note', 'edit-') }}</label>
          <button type="submit" class="span-2">Guardar cambios</button>
        </form>
      </details>
      <div class="paper-panel action-stack">
        <form method="post" action="/projects/{{ project.id }}/findings/{{ finding.id }}/status" class="form-grid">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Nuevo estado <select name="status" {{ invalid(statusErrors, 'status', 'status-') }}>{% for option in statusOptions %}<option value="{{ option.value }}"{% if statusDraft.status == option.value %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select>{{ fieldError(statusErrors, 'status', 'status-') }}</label>
          <label>Nota <span class="optional">obligatoria al resolver o descartar</span><textarea name="note" maxlength="5000" rows="3" {{ invalid(statusErrors, 'note', 'status-') }}>{{ statusDraft.note or '' }}</textarea>{{ fieldError(statusErrors, 'note', 'status-') }}</label>
          <button type="submit">Cambiar estado</button>
        </form>
        <form method="post" action="/projects/{{ project.id }}/findings/{{ finding.id }}/notes" class="form-grid note-form">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <label>Añadir nota <textarea name="note" required maxlength="5000" rows="3" {{ invalid(noteErrors, 'note', 'note-') }}>{{ noteForm.note or '' }}</textarea>{{ fieldError(noteErrors, 'note', 'note-') }}</label>
          <button type="submit" class="button--ink">Guardar nota</button>
        </form>
      </div>
    </div>
  </section>

  <section class="history" aria-labelledby="history-title">
    <p class="section-label">Registro de actividad</p><h2 id="history-title">Historial</h2>
    <ol>{% for event in finding.history %}<li><time datetime="{{ event.createdAt }}">{{ event.createdAt | friendlyDate }}</time><div><strong>{{ eventLabels[event.kind] }}</strong><p class="history-actor">{% if event.actor %}{{ event.actor.name }} · {{ event.actor.slug }}{% else %}Autor desconocido{% endif %}</p>{% if event.fromStatus or event.toStatus %}<p>{{ statusLabels[event.fromStatus] or 'Inicio' }} → {{ statusLabels[event.toStatus] }}</p>{% endif %}{% if event.note %}<p class="preserve-lines">{{ event.note }}</p>{% endif %}{% if event.changes %}<ul class="change-list">{% for field, change in event.changes %}<li><code>{{ field }}</code>: {{ change.from }} → {{ change.to }}</li>{% endfor %}</ul>{% endif %}</div></li>{% endfor %}</ol>
  </section>
{% endblock %}
