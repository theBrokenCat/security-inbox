{% extends "base.njk" %}
{% from "forms.njk" import feedback, invalid, fieldError %}
{% block title %}Nueva incidencia · {{ project.name }}{% endblock %}
{% block content %}
  <nav class="breadcrumbs" aria-label="Migas de pan"><a href="/">Proyectos</a><span>/</span><a href="/projects/{{ project.id }}/findings">{{ project.name }}</a><span>/</span><span>Nueva incidencia</span></nav>
  <section class="page-heading page-heading--compact"><div><h1>Apuntar incidencia</h1><p class="lede">Guarda lo observado y sigue con tu tarea. Puedes investigarlo y completar los detalles más adelante.</p></div></section>

  {{ feedback(formError) }}
  {% if duplicates !== null %}
    <aside class="duplicate-box" aria-live="polite">
      <p class="section-label">Comprobación de duplicados</p>
      {% if duplicates.length %}
        <h2>{{ duplicates.length }} posible{% if duplicates.length != 1 %}s{% endif %} parecido{% if duplicates.length != 1 %}s{% endif %}</h2>
        <ul>{% for duplicate in duplicates %}<li><a href="/projects/{{ project.id }}/findings/{{ duplicate.id }}">{{ duplicate.title }}</a> — {% if duplicate.match == 'exact' %}Coincidencia exacta{% else %}Coincidencia similar{% endif %}</li>{% endfor %}</ul>
      {% else %}
        <h2>Sin coincidencias cercanas</h2><p>Puedes guardar la incidencia; esta comprobación no garantiza que sea única.</p>
      {% endif %}
    </aside>
  {% endif %}

  <form method="post" action="/projects/{{ project.id }}/findings" class="paper-panel finding-form">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
    <input type="hidden" name="idempotencyKey" value="{{ form.idempotencyKey }}">
    <label class="span-2">Título <input name="title" required maxlength="200" value="{{ form.title or '' }}" autocomplete="off" {{ invalid(fieldErrors, 'title') }}>{{ fieldError(fieldErrors, 'title') }}</label>
    <label class="span-2">Contexto <textarea name="description" required maxlength="10000" rows="4" placeholder="Qué has observado y qué ayudará a retomarlo." {{ invalid(fieldErrors, 'description') }}>{{ form.description or '' }}</textarea>{{ fieldError(fieldErrors, 'description') }}</label>
    <label>Archivo <span class="optional">opcional</span><input name="filePath" maxlength="1000" value="{{ form.filePath or '' }}" autocomplete="off" {{ invalid(fieldErrors, 'filePath') }}>{{ fieldError(fieldErrors, 'filePath') }}</label>
    <label>Línea <span class="optional">opcional</span><input name="lineNumber" type="number" min="1" max="10000000" value="{{ form.lineNumber or '' }}" {{ invalid(fieldErrors, 'lineNumber') }}>{{ fieldError(fieldErrors, 'lineNumber') }}</label>
    <details class="span-2 finding-extra"{% if formError or (form.severity and form.severity != 'unclassified') or form.origin or form.commitRef or form.evidence or form.recommendation %} open{% endif %}>
      <summary>Más detalles <span class="optional">opcionales</span></summary>
      <div class="finding-form finding-form--compact">
        <label>Gravedad <select name="severity" {{ invalid(fieldErrors, 'severity') }}>{% for option in severityOptions %}<option value="{{ option.value }}"{% if (form.severity or 'unclassified') == option.value %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select>{{ fieldError(fieldErrors, 'severity') }}</label>
        <label>Origen <input name="origin" maxlength="200" value="{{ form.origin or '' }}" placeholder="Se registra automáticamente" autocomplete="off" {{ invalid(fieldErrors, 'origin') }}>{{ fieldError(fieldErrors, 'origin') }}</label>
        <label class="span-2">Commit <input name="commitRef" maxlength="200" value="{{ form.commitRef or '' }}" autocomplete="off" {{ invalid(fieldErrors, 'commitRef') }}>{{ fieldError(fieldErrors, 'commitRef') }}</label>
        <label class="span-2">Evidencia <textarea name="evidence" maxlength="10000" rows="4" {{ invalid(fieldErrors, 'evidence') }}>{{ form.evidence or '' }}</textarea>{{ fieldError(fieldErrors, 'evidence') }}</label>
        <label class="span-2">Recomendación <textarea name="recommendation" maxlength="5000" rows="3" {{ invalid(fieldErrors, 'recommendation') }}>{{ form.recommendation or '' }}</textarea>{{ fieldError(fieldErrors, 'recommendation') }}</label>
      </div>
    </details>
    <div class="form-actions span-2">
      <button type="submit" formaction="/projects/{{ project.id }}/findings/precheck" formnovalidate class="button--paper">Comprobar parecidos</button>
      <button type="submit">Guardar incidencia</button>
    </div>
  </form>
{% endblock %}
