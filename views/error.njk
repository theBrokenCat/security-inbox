{% extends "base.njk" %}
{% block title %}{{ title }} · Security Inbox{% endblock %}
{% block content %}
  <section class="error-sheet" role="alert">
    <p class="section-label">No se completó la operación{% if code %} · {{ code }}{% endif %}</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ message }}</p>
    {% if fields.length %}<p>Campos a revisar: {% for field in fields %}<code>{{ field }}</code>{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
    <a class="button-link" href="/">Volver a proyectos</a>
  </section>
{% endblock %}
